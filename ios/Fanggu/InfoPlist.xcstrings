    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With “Always”, Fanggu can remind you of unvisited monuments within 3 km even when it isn't open. Your location is compared on this device only and is never saved or uploaded."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「常に」を選ぶと、訪古を開いていないときも3km以内の未訪問の古跡を通知できます。位置はこの端末内で距離の比較に使うだけで、保存も送信もしません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择“始终允许”后，访古不在前台时也能提醒你附近 3 公里内的未打卡古迹。位置只在本机比较距离，不会保存或上传。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to browse monuments by distance and to remind you when an unvisited monument is within 3 km. Your location is compared on this device only and is never saved or uploaded."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距離順での古跡の閲覧と、3km以内の未訪問の古跡に近づいたときの通知に使います。位置はこの端末内で距離の比較に使うだけで、保存も送信もしません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于按距离浏览古迹，以及在你靠近 3 公里内未打卡的古迹时提醒你。位置只在本机比较距离，不会保存或上传。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves Fanggu cards to your photo library. Fanggu only adds images and never reads your library."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訪古カードを写真ライブラリに保存します。訪古は画像を追加するだけで、ライブラリの内容は読み取りません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把访古卡保存到你的相册。访古只添加图片，不读取相册内容。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
            "value" : "8文字以上"
          }
        }
      }
    },
    "开通后，评价将公开" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once Online, Your Reviews Are Public"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンラインにすると、評価は公開されます"
          }
        }
      }
    },
    "全部历史评分、短评，以及之后的修改都会公开同步。切回单机仅隐藏社区。个人笔记、到访日期和心愿仍保留在本机。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All your past ratings and short reviews, and any later edits, sync publicly. Switching back to solo only hides the community. Personal notes, visit dates and your wishlist stay on this device."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

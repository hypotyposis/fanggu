    "亮色" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライト"
          }
        }
      }
    },
    "亮色如纸，深色如墨。跟随系统会随设备外观切换。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light is like paper, dark like ink. System follows your device's appearance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライトは紙のように、ダークは墨のように。システムを選ぶとデバイスの外観に合わせて切り替わります。"
          }
        }
      }
    },

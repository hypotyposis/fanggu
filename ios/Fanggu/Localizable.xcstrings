{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    " 通知权限已关闭，提醒无法显示。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Notifications are turned off, so reminders can't appear."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知が許可されていないため、近くの古跡の通知を表示できません。"
          }
        }
      }
    },
    "%@ %@，已到访 %lld 处，共 %lld 处" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@, %3$lld of %4$lld visited"

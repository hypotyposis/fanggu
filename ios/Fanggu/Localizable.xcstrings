        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仲間と古跡を読み解く"
          }
        }
      }
    },
    "交换认真看过的细节，收藏下一次出发的理由。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
